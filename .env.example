DATABASE_URL=sqlite:///./students.db
# Generate a secret: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: replace with a generated secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
SQL_ECHO=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Empty for the bundled frontend served by the API (same origin).
CORS_ORIGINS=[]
# Separate development frontend:
# CORS_ORIGINS=["http://localhost:5173"]
# Production: replace these examples with your actual frontend origins.
# CORS_ORIGINS=["https://students.example.com","https://admin.example.com"]
