DATABASE_URL=sqlite:///./students.db
# Required for Compose. Use a generated URL-safe password, e.g. hex characters.
POSTGRES_PASSWORD=
# Compose publishes the API here; Uvicorn on the host uses its CLI --port option.
APP_PORT=8002
# Generate a secret: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required: replace with a generated secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=
SQL_ECHO=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Redis: use the service hostname when running in containers.
REDIS_HOST=localhost
REDIS_PORT=6379
# Student list cache lifetime in seconds; 0 disables caching.
STUDENTS_CACHE_TTL_SECONDS=60
# Use a different namespace for each independent database/environment sharing Redis.
STUDENTS_CACHE_NAMESPACE=student-management
# Empty for the bundled frontend served by the API (same origin).
CORS_ORIGINS=[]
# Separate development frontend:
# CORS_ORIGINS=["http://localhost:5173"]
# Production: replace these examples with your actual frontend origins.
# CORS_ORIGINS=["https://students.example.com","https://admin.example.com"]
