# Copy to .env.compose, then fill both secrets before starting Compose.
# Use URL-safe passwords: ASCII letters, digits, hyphen and underscore.
POSTGRES_PASSWORD=
# Required: a random secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=

# Change to 8001 if the standalone SQLite container still uses port 8000.
APP_PORT=8000
SQL_ECHO=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=[]
