# Optional separate Compose config. Default setup now uses .env.example -> .env.
# To use this file, copy to .env.compose and pass --env-file .env.compose.
# Use URL-safe passwords: ASCII letters, digits, hyphen and underscore.
POSTGRES_PASSWORD=
# Required: a random secret of at least 32 UTF-8 bytes.
JWT_SECRET_KEY=

APP_PORT=8002
SQL_ECHO=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=[]
STUDENTS_CACHE_TTL_SECONDS=60
STUDENTS_CACHE_NAMESPACE=student-management-compose
